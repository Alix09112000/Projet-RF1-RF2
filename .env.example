# Copier ce fichier en .env et remplacer les valeurs.

# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=rf

# Clé de signature des sessions : une longue chaîne aléatoire.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer

# Durée d'une session, en heures
SESSION_HOURS=10

# true dès que l'outil est servi en HTTPS
COOKIE_SECURE=false

# Origines autorisées à appeler l'API (format JSON)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Compte administrateur créé au premier démarrage (10 caractères minimum)
ADMIN_EMAIL=admin@canalbox.ci
ADMIN_PASSWORD=a-remplacer-1234
ADMIN_NAME=Administrateur
